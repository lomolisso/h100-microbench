#!/usr/bin/env bash
# GPU inspection and launch preflight (read-only; never touches other users' processes).
#   tools/gpu status            all GPUs: memory, utilization, clocks, compute processes with owners, locks
#   tools/gpu check [--gpu N]   preflight for one authorized GPU (default 2); exit 0 = OK to launch
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/common.sh"

# Owner and container of a host PID (best effort; /proc/<pid>/cgroup is world-readable).
describe_pid() {
    local pid=$1 user etime where cg cid
    user=$(ps -o user= -p "$pid" 2>/dev/null | tr -d ' ') || true
    etime=$(ps -o etime= -p "$pid" 2>/dev/null | tr -d ' ') || true
    cg=$(cat "/proc/$pid/cgroup" 2>/dev/null || true)
    where=host
    if [[ "$cg" =~ docker-([0-9a-f]{64}) ]]; then
        cid=${BASH_REMATCH[1]}
        where="container $(docker inspect --format '{{.Name}}' "$cid" 2>/dev/null || echo "${cid:0:12}")"
    elif [[ "$cg" == *kubepods* ]]; then
        where="kubernetes pod"
    fi
    echo "user=${user:-?} elapsed=${etime:-?} ($where)"
}

compute_apps() {  # compute_apps <uuid>  ->  "pid, name, used_mib" lines
    nvidia-smi --query-compute-apps=gpu_uuid,pid,process_name,used_memory --format=csv,noheader,nounits \
        | awk -F', ' -v u="$1" '$1==u {print $2", "$3", "$4}'
}

lock_holder() {  # prints holder info if the lock is currently held
    local f=$LOCK_DIR/gpu$1.lock
    [[ -e "$f" ]] || return 0
    if ! flock -n "$f" true 2>/dev/null; then cat "$f" 2>/dev/null || echo "held (holder unknown)"; fi
}

cmd_status() {
    nvidia-smi --query-gpu=index,uuid,pci.bus_id,memory.used,memory.total,utilization.gpu,clocks.sm,clocks.mem,temperature.gpu,power.draw \
        --format=csv | column -t -s,
    echo
    echo "Compute processes:"
    local any=0 line uuid pid name mem idx
    while IFS=', ' read -r uuid pid name mem; do
        [[ -n "$uuid" ]] || continue; any=1
        idx=$(nvidia-smi --query-gpu=index --format=csv,noheader -i "$uuid")
        printf '  GPU %s  pid %-8s %-22s %7s MiB  %s\n' "$idx" "$pid" "$name" "$mem" "$(describe_pid "$pid")"
    done < <(nvidia-smi --query-compute-apps=gpu_uuid,pid,process_name,used_memory --format=csv,noheader,nounits)
    (( any )) || echo "  (none)"
    echo
    echo "Cooperative locks ($LOCK_DIR):"
    for i in "${!GPU_UUID[@]}"; do
        h=$(lock_holder "$i"); printf '  GPU %s: %s\n' "$i" "${h:-free}"
    done
    echo
    echo "Our containers (label h100mb.owner=$USER; should be empty when nothing is running):"
    docker ps -a --filter "label=h100mb.owner=$USER" --format '  {{.Names}}  {{.Status}}' 2>/dev/null | grep . || echo "  (none)"
    echo
    echo "Note: GPUs 2,3 are also advertised to Kubernetes (nvidia-device-plugin); pod allocations are not visible from this account."
}

cmd_check() {
    local gpu=$DEFAULT_GPU
    while [[ $# -gt 0 ]]; do
        case $1 in --gpu) gpu=$2; shift 2 ;; *) die "unknown option $1" ;; esac
    done
    resolve_gpu "$gpu"
    local fail=0 warn=0
    bad()  { say "  BUSY  $*"; fail=1; }
    ok()   { say "  ok    $*"; }
    note() { say "  warn  $*"; warn=1; }
    say "Preflight for GPU $GPU_IDX ($UUID, $PCI) at $(date -Iseconds)"

    # 1. physical identity: index, UUID and PCI bus id must still agree (catches re-enumeration).
    local got
    got=$(nvidia-smi -i "$UUID" --query-gpu=index,pci.bus_id,name --format=csv,noheader 2>/dev/null) \
        || die "UUID $UUID not found by nvidia-smi"
    [[ "$got" == "$GPU_IDX, $PCI, "* ]] || die "device mapping changed: expected index $GPU_IDX / $PCI, nvidia-smi says '$got'"
    ok "identity: $got"

    # 2. compute processes on that GPU (any user, any container).
    local apps; apps=$(compute_apps "$UUID")
    if [[ -n "$apps" ]]; then
        while IFS=', ' read -r pid name mem; do bad "process pid=$pid $name ${mem}MiB $(describe_pid "$pid")"; done <<< "$apps"
    else
        ok "no compute processes"
    fi

    # 3. memory and utilization, sampled over ~2 s.
    local mem util maxutil=0 s
    for s in 1 2 3 4 5; do
        IFS=', ' read -r mem util < <(nvidia-smi -i "$UUID" --query-gpu=memory.used,utilization.gpu --format=csv,noheader,nounits)
        (( util > maxutil )) && maxutil=$util
        sleep 0.4
    done
    (( mem > BUSY_MEM_MIB )) && bad "memory used ${mem} MiB > ${BUSY_MEM_MIB}" || ok "memory used ${mem} MiB"
    (( maxutil > BUSY_UTIL_PCT )) && bad "utilization up to ${maxutil}% > ${BUSY_UTIL_PCT}%" || ok "utilization max ${maxutil}%"

    # 4. running containers that were given this GPU (a container can hold a GPU while idle).
    #    Only an explicit assignment (index or UUID) refuses. A container that merely sees `all` GPUs is a warning:
    #    the users of GPUs 0/1 never use GPUs 2/3, and actual use of this GPU is caught by checks 2-3.
    local name vis cbad=0
    while read -r name vis; do
        [[ -n "$name" ]] || continue
        case $name in
            /k8s_nvidia-device-plugin*|/k8s_exporter_dcgm-exporter*) continue ;;  # cluster infrastructure, not a workload
        esac
        if [[ ",$vis," == *",$GPU_IDX,"* || "$vis" == *"$UUID"* ]]; then
            cbad=1; bad "container $name was given this GPU (NVIDIA_VISIBLE_DEVICES/--gpus = $vis)"
        elif [[ ",$vis," == *",all,"* ]]; then
            note "container $name can see all GPUs (NVIDIA_VISIBLE_DEVICES/--gpus = $vis) but is not assigned this one; not blocking"
        fi
    done < <(docker ps -q 2>/dev/null | xargs -r docker inspect --format \
        '{{.Name}} {{range .Config.Env}}{{if eq (index (split . "=") 0) "NVIDIA_VISIBLE_DEVICES"}}{{index (split . "=") 1}},{{end}}{{end}}{{range .HostConfig.DeviceRequests}}{{join .DeviceIDs ","}}{{if eq .Count -1}}all{{end}},{{end}}' 2>/dev/null \
        | awk 'NF==2')
    (( cbad )) || ok "no other container was assigned this GPU"

    # 5. cooperative lock.
    local holder; holder=$(lock_holder "$GPU_IDX")
    [[ -n "$holder" ]] && bad "cooperative lock held: $holder" || ok "cooperative lock free"

    # 6. reservation (informational unless H100MB_REQUIRE_RESERVATION=1).
    local now; now=$(date +%s); local covered=""
    if [[ -r "$RESERVATIONS" ]]; then
        while IFS=$'\t' read -r g start end rnote; do
            [[ "$g" == "$GPU_IDX" ]] || continue
            if (( $(date -d "$start" +%s) <= now && now <= $(date -d "$end" +%s) )); then covered="$start → $end ${rnote:-}"; fi
        done < <(grep -v '^#' "$RESERVATIONS")
    fi
    if [[ -n "$covered" ]]; then ok "reservation: $covered"
    elif [[ "${H100MB_REQUIRE_RESERVATION:-0}" == 1 ]]; then bad "no reservation in $RESERVATIONS covers now"
    else note "no recorded reservation covers now ($RESERVATIONS)"; fi

    note "Kubernetes may allocate GPU $GPU_IDX to a pod; allocations are not visible from this account."
    say "  (a passing preflight is a snapshot, not exclusive ownership)"
    if (( fail )); then say "REFUSED: GPU $GPU_IDX is not safely available."; return 1; fi
    say "OK: GPU $GPU_IDX looks free."
}

case ${1:-status} in
    status) shift || true; cmd_status "$@" ;;
    check)  shift; cmd_check "$@" ;;
    *) sed -n '2,4p' "$0" >&2; exit 2 ;;
esac
