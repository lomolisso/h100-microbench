#!/usr/bin/env bash
# Environment management.
#   tools/env info                      image, container-store free space
#   tools/env build                     build the docker image (refuses if the container store is nearly full)
#   tools/env verify [--gpu N] [--profile]   toolchain + tiny GPU probe + one-metric ncu probe
#   tools/env lock                      re-resolve requirements.txt → requirements.lock (in the container)
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/common.sh"

cmd_info() {
    echo "repo:            $H100MB_ROOT"
    echo "container store: $CONTAINERD_DIR — $(containerd_free_gb) GB free (build needs $MIN_BUILD_FREE_GB, run needs $MIN_RUN_FREE_GB)"
    echo "image:           $IMAGE  $(image_present && echo '(present)' || echo '(NOT built)')"
}

cmd_build() {
    local free; free=$(containerd_free_gb)
    (( free >= MIN_BUILD_FREE_GB )) || die "container store (shared scratch volume) has ${free} GB free; need ≥ ${MIN_BUILD_FREE_GB} GB. Building now would fill a disk other users depend on."
    docker build -f "$H100MB_ROOT/docker/Dockerfile" -t "$IMAGE" -t "$IMAGE_REPO:latest" \
        --label h100mb.owner="$USER" "$H100MB_ROOT"
    # Keep exactly one image: remove our superseded builds (only images labelled as ours; no -f, so an
    # image still used by a container is left alone).
    local cur old; cur=$(docker image inspect --format '{{.Id}}' "$IMAGE")
    for old in $(docker images -q --no-trunc --filter "label=h100mb.owner=$USER" | sort -u); do
        [[ "$old" == "$cur" ]] && continue
        if docker rmi "$old" >/dev/null 2>&1; then echo "removed old image ${old:7:12}"; fi
    done
}

cmd_lock() {
    "$H100MB_ROOT/tools/run" --no-gpu -- bash -c "
        set -e; python3 -m venv /tmp/v && /tmp/v/bin/pip install -q -r '$H100MB_ROOT/requirements.txt'
        { echo '# Fully pinned Python environment (pip freeze, resolved $(date +%F), Python 3.12).'
          echo '# Top-level intent lives in requirements.txt; regenerate with: tools/env lock'
          /tmp/v/bin/pip freeze; } > '$H100MB_ROOT/requirements.lock'"
    echo "wrote requirements.lock (rebuild the image: tools/env build)"
}

cmd_verify() {
    local gpuargs=() p=()
    while [[ $# -gt 0 ]]; do
        case $1 in --gpu) gpuargs=(--gpu "$2"); shift 2 ;; --profile) p=(--profile); shift ;;
                   *) die "unknown option $1" ;; esac
    done
    local src=$H100MB_ROOT/tools/verify/devquery.cu
    local build="nvcc -arch=sm_90a -O3 -lineinfo -o /tmp/devquery '$src'"
    echo "== 1/3 toolchain (no GPU)"
    "$H100MB_ROOT/tools/run" --no-gpu -- bash -c "
        set -e; nvcc --version | tail -2; ncu --version | tail -1; nsys --version; python --version
        python -c 'import numpy, pandas, matplotlib, scipy, sklearn, nbformat, nbconvert; print(\"python stack ok: numpy\", numpy.__version__, \"pandas\", pandas.__version__)'
        $build; cuobjdump -sass /tmp/devquery | grep -cE 'CS2R|S2R .*SR_SMID' | sed 's/^/SASS timer\/smid instructions: /'"
    echo "== 2/3 GPU probe (1 block x 32 threads)"
    "$H100MB_ROOT/tools/run" "${gpuargs[@]}" -- bash -c "set -e; $build; /tmp/devquery"
    echo "== 3/3 Nsight Compute, one metric on the probe kernel"
    "$H100MB_ROOT/tools/run" "${p[@]}" "${gpuargs[@]}" -- bash -c "set -e; $build
        ncu --clock-control none --metrics sm__cycles_elapsed.avg.per_second --csv --page raw \
            --print-units base /tmp/devquery 2>&1 | grep -E '==ERROR==|^\"|sm__cycles' || true"
}

case ${1:-info} in
    info) cmd_info ;; build) cmd_build ;; lock) cmd_lock ;;
    verify) shift; cmd_verify "$@" ;;
    *) sed -n '2,6p' "$0" >&2; exit 2 ;;
esac
